<%- include("templates/header.ejs") %>

<header class="container-fluid">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h1 id="title">Bivalyhágnádi Cicccaaaaaügyi Minisztérium | Képességek</h1>
    </div>
</header>
<hr>
<main class="container-fluid">
    <div id="cat-item-header">
        <p>Név</p>
        <div class="verticalLine"></div>
        <p>Rövid leírás</p>
        <div class="verticalLine"></div>
        <p>Törlés?</p>
    </div>
    <div id="cat-list">
        <% for (ability of abilities) { %>
            <div class="cat-item">
                <p><a href="/ability/<%= ability._id %>"><%= ability.name %></a></p>
                <div class="verticalLine"></div>
                <p><%= ability.shortDesc %></p>
                <div class="verticalLine"></div>
                <button style="background-color: red"
                        onclick="fetch('/api/abilities/<%= ability._id %>', {method: 'DELETE'})
                                .then(response => {
                                    if (response.ok) {
                                        window.location.href = '/ability_list';
                                }})"
                >Képesség törlése
                </button>
            </div>
        <% } %>
    </div>
</main>

<footer class="container-fluid">
    <div class="cat-controls">
        <button onclick="window.location.href='/addEditAbility'">Új képesség</button>
        <button onclick="window.location.href='/'">Vissza a főoldalra</button>
    </div>
</footer>
<%- include("templates/footer.ejs") %>
