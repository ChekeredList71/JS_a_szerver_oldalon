<%- include("../templates/header.ejs")%>

<header class="container-fluid">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h1 id="title"></h1>
        <script>document.getElementById("title").innerHTML = `Bivalyhágnádi Cicccaaaaaügyi Minisztérium | Képesség`</script>
    </div>
</header>
<main class="container-fluid">
    <div class="left-aligned-screenfill-flexbox">
        <form id="ability-submission-form" method="post" action="/api/abilities/<%= typeof ability === "undefined" ? "add" : `${ability._id}/edit` %>"  enctype="multipart/form-data">
            <label for="ability-form-name">Név</label>
            <input type="text" name="name" id="ability-form-name" value="<%= typeof ability === 'undefined' ? '' : ability.name %>" required/>
            <label for="ability-form-shortDesc">Rövid leírás</label>
            <input type="text" name="shortDesc" id="ability-form-shortDesc" value="<%= typeof ability === 'undefined' ? '' : ability.shortDesc %>"  required/>
            <label for="ability-form-longDesc">Hosszú leírás</label>
            <textarea type="text" name="longDesc" id="ability-form-longDesc" required style="height: 45%"><%= typeof ability === 'undefined' ? '' : ability.longDesc %></textarea>
            <label for="ability-form-abilityPic">CICCAAAkép</label>
            <input type="file" name="abilityPic" id="ability-form-abilityPic" <%- typeof ability === 'undefined' ? 'required' : '' %>/>
            <button type="submit">Mentés</button>
        </form>
    </div>
</main>

<footer class="container-fluid">
    <div class="cat-controls">
        <button onclick="window.location.href='/ability_list'">Vissza a képességekhez</button>
    </div>
</footer>
<%- include("../templates/footer.ejs")%>
